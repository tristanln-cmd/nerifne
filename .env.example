# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase (see SUPABASE_SETUP.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Owner ---
OWNER_EMAIL=

# --- Plugin license admin panel ---
PLUGIN_LICENSE_ADMIN_TOKEN=

# --- Plugin license checkpoint / free key giveaway (/get-key) ---
CHECKPOINT_SECRET=
NEXT_PUBLIC_ADSENSE_CHECKPOINT_SLOT_1=
NEXT_PUBLIC_ADSENSE_CHECKPOINT_SLOT_2=
NEXT_PUBLIC_ADSENSE_CHECKPOINT_SLOT_3=
NEXT_PUBLIC_ADSENSE_CHECKPOINT_SLOT_4=

# --- Maintenance mode bypass (optional) ---
MAINTENANCE_BYPASS_SECRET=

# --- AdSense (optional — kept for pages where it's still viable) ---
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT_ID=

# --- Adsterra (used on /get-key) ---
NEXT_PUBLIC_ADSTERRA_CHECKPOINT_KEY_1=
NEXT_PUBLIC_ADSTERRA_CHECKPOINT_KEY_2=
NEXT_PUBLIC_ADSTERRA_CHECKPOINT_KEY_3=
NEXT_PUBLIC_ADSTERRA_CHECKPOINT_KEY_4=
NEXT_PUBLIC_ADSTERRA_RECTANGLE_KEY=
NEXT_PUBLIC_ADSTERRA_SKYSCRAPER_KEY=
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_SRC=
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_CONTAINER_ID=
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SRC=
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=

# --- Keepalive / expired-key cleanup cron (/api/cron/keepalive) ---
CRON_SECRET=

# --- Misc ---
NEXT_PUBLIC_BASE_URL=https://your-domain.example
